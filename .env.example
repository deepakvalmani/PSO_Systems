# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB Atlas connection string for persistent cloud database.
# If unset, Mongo-backed persistence is disabled and the app falls back to
# the local JSON file store (data/ledger_store.json). Never commit a real
# value here — this file is a template only.
MONGODB_URI=

# JWT_SECRET: secret used to sign session cookies (auth). Required in
# production — the server refuses to start without it in production mode.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# NODE_ENV: set to "production" when deploying.
NODE_ENV=development
